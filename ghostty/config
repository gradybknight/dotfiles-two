# ~~~~~~~~~~~~~~~ Ghostty ~~~~~~~~~~~~~~~~~~~~~~~~
# Reload after editing: Cmd+Shift+, (or quit + reopen).
# See all options: `ghostty +show-config --default --docs | less`

# ---- Appearance ----
theme = Catppuccin Mocha
# "FiraCode Nerd Font" is a superset of "Fira Code" — no separate fallback needed.
font-family = "FiraCode Nerd Font"
font-size = 17
font-thicken = true
adjust-cell-height = 12%

# Slight transparency so the blur reads; set to 1.0 to make it fully opaque.
background-opacity = 0.95
background-blur = 20
unfocused-split-opacity = 0.85

# ---- Window ----
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
# Padding takes the terminal bg colour instead of the OS window colour.
window-padding-color = extend
macos-titlebar-style = tabs
window-save-state = always
window-colorspace = display-p3

# ---- Cursor ----
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ---- Behaviour ----
# Right Option stays Option (needed for many CLI keybinds); left Option = Alt/Meta.
macos-option-as-alt = left
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
confirm-close-surface = false
shell-integration-features = cursor,sudo,title
# Cmd-click URLs to open them.
link-url = true

# ---- Keybinds ----
# Shift+Enter inserts a newline instead of submitting (Claude Code, REPLs, etc.)
keybind = shift+enter=text:\n
# A global drop-down terminal (toggle from anywhere).
keybind = global:cmd+grave_accent=toggle_quick_terminal
# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size
