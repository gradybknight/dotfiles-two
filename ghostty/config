# ~~~~~~~~~~~~~~~ Ghostty ~~~~~~~~~~~~~~~~~~~~~~~~
# Reload after editing: Cmd+Shift+, (or quit + reopen).
# See all options: `ghostty +show-config --default --docs | less`

# ---- Appearance ----
theme = Catppuccin Mocha
font-family = "FiraCode Nerd Font"
font-family = "Fira Code"
font-size = 16
font-thicken = true
adjust-cell-height = 12%

background-opacity = 1.0
background-blur = 20
unfocused-split-opacity = 0.85

# ---- Window ----
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = tabs
window-save-state = always
window-colorspace = display-p3

# ---- Cursor ----
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ---- Behaviour ----
# Right Option stays Option (needed for many CLI keybinds); left Option = Alt/Meta.
macos-option-as-alt = left
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
confirm-close-surface = false
shell-integration-features = cursor,sudo,title

# ---- Keybinds ----
# Shift+Enter inserts a newline instead of submitting (Claude Code, REPLs, etc.)
keybind = shift+enter=text:\n
# A global drop-down terminal (toggle from anywhere).
keybind = global:cmd+grave_accent=toggle_quick_terminal
# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size
